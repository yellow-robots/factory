# Copy to ~/.config/dev-runner/pm-dispatch.env and `chmod 600`. NOT committed — holds the shared
# secret plus the credentials the build instance's dispatch.env never carries.
#
# The bearer token n8n must send for THIS instance — a DIFFERENT random value from the build
# instance's DISPATCH_TOKEN (the same n8n workflow file must never reuse the build token here).
DISPATCH_TOKEN=CHANGE_ME_long_random_shared_with_n8n_pm_only
#
# Localhost only (it-36 slice D, #469): this is the one dispatch instance the vault key reaches, so
# it is never exposed past the loopback interface, unlike the build instance's docker-bridge bind.
DISPATCH_BIND=127.0.0.1
DISPATCH_PORT=8771
#
# The spawned design-sweep needs these on PATH (claude, gh, git); the service env is otherwise minimal.
PATH=/home/REPLACE_RUNNER_USER/.local/bin:/usr/bin:/bin
#
# The PM acts on every native surface under the App's identity, never the owner's (it-36 slice E,
# #470): GH_BIN points every `gh` call in the runner, the gate, the sources and the PM at the
# on-demand App-token wrapper (tools/gh-app) instead of the bare `gh` CLI. The wrapper mints/caches/
# re-mints the installation token itself from the App identity below — GH_BIN is the whole switch.
GH_BIN=/home/REPLACE_RUNNER_USER/yellow-robots/factory/tools/gh-app
#
# The PM instance's own credential seam (tools/dispatch.py _PM_ONLY_KEYS): this key is declared
# HERE, not in the build instance's dispatch.env — it is not even a member of the general
# allowlist (_ENV_ALLOW_KEYS). Which instance is running (and therefore whether this key's value
# is ever handed to a spawned child) is decided by pm-dispatch.service's ExecStart `--instance pm`
# flag alone, never by anything in this file — an env var can never carry that decision (a unit's
# EnvironmentFile always overrides its own Environment=, per systemd.exec(5), so the discriminator
# had to move off the env channel entirely).
YR_VAULT_API_KEY=CHANGE_ME_vault_read_key
#
# tools/notify.py's HMAC signing key (it-36 slice I, #474 — item P, the owner's own webhook signing
# secret): same PM-only reasoning as the vault key above, joins it in _PM_ONLY_KEYS. Signs every
# telegram/webhook stakeholder POST (X-YR-Signature); never printed, logged, or embedded in a record.
YR_NOTIFY_SECRET=CHANGE_ME_notify_hmac_secret
#
# The GitHub App identity the design-sweep authenticates as when filing/linking issues. Not
# vault-gated: a future build-instance need for the same App identity may declare these too.
YR_GH_APP_ID=CHANGE_ME
YR_GH_APP_KEY_PATH=/home/REPLACE_RUNNER_USER/.config/dev-runner/gh-app.pem
YR_GH_APP_INSTALLATION=CHANGE_ME
YR_GH_APP_SLUG=CHANGE_ME
YR_OWNER_LOGIN=yellow-robots
