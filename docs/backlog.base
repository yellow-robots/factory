filters:
  and:
    - file.inFolder("seeds")
    - type == "seed"
    - status != "rejected"
formulas:
  rank: if(value && effort, (value - if(effort == "S", 0, if(effort == "M", 0.5, 1))).round(1), "")
properties:
  status:
    displayName: Status
  summary:
    displayName: Summary
  formula.rank:
    displayName: Rank
  value:
    displayName: Value
  effort:
    displayName: Effort
  reporter:
    displayName: Reporter
  kind:
    displayName: Kind
  version:
    displayName: Version
  created:
    displayName: Born
views:
  - type: table
    name: Pending
    filters:
      or:
        - status == "open"
        - status == "spec"
        - status == "building"
    order:
      - file.name
      - status
      - version
      - summary
      - formula.rank
      - value
      - effort
      - kind
      - reporter
      - created
    sort:
      - property: formula.rank
        direction: DESC
      - property: created
        direction: ASC
  - type: table
    name: By kind
    filters:
      or:
        - status == "open"
        - status == "spec"
        - status == "building"
    groupBy:
      property: kind
      direction: ASC
    order:
      - file.name
      - status
      - version
      - summary
      - formula.rank
      - reporter
    sort:
      - property: formula.rank
        direction: DESC
      - property: created
        direction: ASC
  - type: table
    name: By version
    groupBy:
      property: version
      direction: DESC
    order:
      - file.name
      - status
      - summary
      - formula.rank
      - effort
      - kind
    sort:
      - property: formula.rank
        direction: DESC
      - property: summary
        direction: ASC
  - type: table
    name: Specs
    filters:
      and:
        - version == this.file.basename
    order:
      - file.name
      - status
      - summary
      - effort
  - type: table
    name: Archive
    filters:
      or:
        - status == "done"
        - status == "rejected"
    order:
      - file.name
      - status
      - version
