+"""The files a run leaves, in the order the README lists them, and the one to read first.
+
+FILES names every file a run's directory under runs/<utc-stamp>/ holds, in the order the README
+lists them: goal.txt, wire.jsonl, messages.json, one check-<n>.log per check, diff.patch,
+report.json, response.md and numbers.json. FIRST is the one to read first, the record's numbers.
+"""
+
+FILES = (
+    "goal.txt",
+    "wire.jsonl",
+    "messages.json",
+    "check-<n>.log",
+    "diff.patch",
+    "report.json",
+    "response.md",
+    "numbers.json",
+)
+FIRST = "numbers.json"
