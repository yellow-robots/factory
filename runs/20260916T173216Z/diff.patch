+#!/usr/bin/env python3
+"""The files a run leaves, named as README lists them.
+
+`FILES` is every file under `runs/<utc-stamp>/`, in the order README lists them; `check-<n>.log`
+stands for one file per check, its number in place of `<n>`. `FIRST` is the one to read first:
+`numbers.json`, the run's own account of itself.
+"""
+
+from __future__ import annotations
+
+FILES = (
+    "goal.txt",
+    "wire.jsonl",
+    "messages.json",
+    "check-<n>.log",
+    "diff.patch",
+    "report.json",
+    "response.md",
+    "numbers.json",
+)
+
+FIRST = "numbers.json"
