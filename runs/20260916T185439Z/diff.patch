+def strip_comments(text: str) -> str:
+    """The note without its `%%` comments: everything between two marks, on one line or across
+    many, is not the note's text, so a heading inside one is not a heading."""
+    out: list[str] = []
+    i = 0
+    in_comment = False
+    while i < len(text):
+        if text.startswith("%%", i):
+            in_comment = not in_comment
+            i += 2
+        elif in_comment:
+            i += 1  # inside a comment: the bytes, the newlines and all, are not the note's text
+        else:
+            out.append(text[i])
+            i += 1
+    return "".join(out)
+
+
+def fence(line: str) -> bool:
+    """Whether the line opens or closes a fenced code block: ``` or ~~~, with any info string."""
+    stripped = line.lstrip()
+    return stripped.startswith("```") or stripped.startswith("~~~")
+
+
+def heading_level(line: str) -> int:
+    """The level of a markdown ATX heading, 0 when the line is not one: one to six #s, then a
+    space or the end of the line."""
+    stripped = line.lstrip()
+    n = len(stripped) - len(stripped.lstrip("#"))
+    if n == 0 or (len(stripped) > n and not stripped[n].isspace()):
+        return 0
+    return n
+
+
+def goal_section(text: str) -> str | None:
+    """The text under the note's `## Goal`, from its heading to the next heading of level one or
+    two, or None when the note has no such heading. A fenced code block belongs whole: a heading
+    inside one neither starts the section nor ends it, whatever its lines start with."""
+    lines = text.splitlines()
+    start, in_fence = None, False
+    for i, line in enumerate(lines):
+        if fence(line):
+            in_fence = not in_fence
+        elif not in_fence and line.strip() == "## Goal":
+            start = i
+            break
+    if start is None:
+        return None
+    section: list[str] = []
+    in_fence = False
+    for line in lines[start + 1:]:
+        if fence(line):
+            section.append(line)
+            in_fence = not in_fence
+        elif not in_fence and heading_level(line) in (1, 2):  # the next section ends the text
+            break
+        else:
+            section.append(line)
+    return "\n".join(section).strip()
+
