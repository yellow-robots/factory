+def _dot_root(text: str, dot: int) -> str:
+    """The identifier immediately before the `.` at `dot`, if there is one."""
+    i = dot - 1
+    while i >= 0 and text[i].isspace():
+        i -= 1
+    end = i + 1
+    while i >= 0 and (text[i].isalnum() or text[i] == "_"):
+        i -= 1
+    return text[i + 1:end]
